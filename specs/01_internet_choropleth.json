{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 390,
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },
  "transform": [
    {
      "lookup": "id",
      "from": {
        "data": {
          "values": []
        },
        "key": "geo_id",
        "fields": [
          "metric",
          "country",
          "year"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#fff",
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "field": "metric",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ],
        "scheme": "tealblues"
      },
      "legend": {
        "title": "People using internet (%)",
        "orient": "bottom",
        "gradientLength": 260
      }
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "metric",
        "type": "quantitative",
        "title": "Internet users (%)",
        "format": ".1f"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      }
    ]
  }
}
