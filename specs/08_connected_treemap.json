{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 390,
  "data": {
    "values": []
  },
  "mark": {
    "type": "rect",
    "stroke": "#fff",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "x0",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "x2": {
      "field": "x1"
    },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          100
        ],
        "reverse": true
      }
    },
    "y2": {
      "field": "y1"
    },
    "color": {
      "field": "continent",
      "type": "nominal",
      "legend": {
        "orient": "bottom"
      },
      "scale": {
        "scheme": "tableau10"
      }
    },
    "tooltip": [
      {
        "field": "country"
      },
      {
        "field": "connected",
        "title": "Estimated internet users",
        "format": ",.0f"
      },
      {
        "field": "penetration",
        "title": "Internet use (%)",
        "format": ".1f"
      }
    ]
  }
}
