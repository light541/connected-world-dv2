{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 390,
  "data": {
    "values": []
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "continent",
          "type": "nominal",
          "legend": {
            "orient": "bottom"
          },
          "scale": {
            "domain": [
              "Africa",
              "Americas",
              "Asia",
              "Europe",
              "Oceania"
            ],
            "range": [
              "#8a9e8a",
              "#d1a17d",
              "#3a8290",
              "#6f9da2",
              "#b1a4ad"
            ]
          },
          "title": "Continent"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal"
          },
          {
            "field": "connected",
            "title": "Estimated internet users",
            "format": ",.0f",
            "type": "quantitative"
          },
          {
            "field": "penetration",
            "title": "Internet use (%)",
            "format": ".1f",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.x1-datum.x0)>=11 && (datum.y1-datum.y0)>=7"
        },
        {
          "calculate": "(datum.x0+datum.x1)/2",
          "as": "labelX"
        },
        {
          "calculate": "(datum.y0+datum.y1)/2",
          "as": "labelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontWeight": "bold",
        "fontSize": 11,
        "limit": 90
      },
      "encoding": {
        "x": {
          "field": "labelX",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "country",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.continent === 'Asia'",
            "value": "#ffffff"
          },
          "value": "#173342"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal"
          },
          {
            "field": "connected",
            "title": "Estimated internet users",
            "format": ",.0f",
            "type": "quantitative"
          },
          {
            "field": "penetration",
            "title": "Internet use (%)",
            "format": ".1f",
            "type": "quantitative"
          }
        ]
      }
    }
  ]
}
