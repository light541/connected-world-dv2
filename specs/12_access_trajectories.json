{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 310,
  "data": {
    "values": []
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [
          2005,
          2027
        ]
      },
      "axis": {
        "format": "d",
        "tickCount": 5
      }
    },
    "y": {
      "field": "metric",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "title": "People using internet (%)"
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {
        "domain": [
          "Malaysia",
          "Singapore",
          "Indonesia",
          "Vietnam",
          "Philippines",
          "World"
        ],
        "range": [
          "#b45b31",
          "#156082",
          "#557c43",
          "#77559b",
          "#b58b20",
          "#415260"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "country"
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "year",
        "type": "quantitative",
        "format": "d",
        "title": "Year"
      },
      {
        "field": "metric",
        "type": "quantitative",
        "format": ".1f",
        "title": "Internet users (%)"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 11,
        "stroke": "transparent"
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "country"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.6
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1
          },
          "value": 0.22
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "value": 3.8
          },
          "value": 2.6
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.labelMetric)"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1.1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "x2": {
          "field": "labelX"
        },
        "y": {
          "field": "metric",
          "type": "quantitative"
        },
        "y2": {
          "field": "labelMetric"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 0.9
          },
          "value": 0.25
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.labelMetric)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 11,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "labelX",
          "type": "quantitative"
        },
        "y": {
          "field": "labelMetric",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1
          },
          "value": 0.8
        }
      }
    }
  ]
}
