{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 340,
  "data": {
    "values": []
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 2,
    "stroke": "#fff",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Market",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Malaysia",
        "Asia",
        "India",
        "Europe",
        "United States",
        "Worldwide"
      ],
      "axis": {
        "labelAngle": -25
      }
    },
    "y": {
      "field": "Vendor",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Apple",
        "Samsung",
        "Xiaomi",
        "Oppo",
        "Vivo",
        "Honor",
        "Motorola",
        "Realme",
        "Google",
        "Unknown"
      ]
    },
    "color": {
      "field": "Share",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          60
        ],
        "scheme": "tealblues"
      },
      "legend": {
        "orient": "bottom",
        "title": "Share of mobile browsing (%)"
      }
    },
    "tooltip": [
      {
        "field": "Market",
        "type": "nominal"
      },
      {
        "field": "Vendor",
        "type": "nominal"
      },
      {
        "field": "Share",
        "type": "quantitative",
        "title": "Mobile browsing share",
        "format": ".2f"
      }
    ]
  }
}
