{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 248,
  "data": {
    "values": []
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 4,
    "stroke": "#fff",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "color": {
      "field": "rate",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          55
        ],
        "scheme": "tealblues"
      },
      "legend": {
        "orient": "bottom",
        "title": "E-waste formally recycled (%)"
      }
    },
    "tooltip": [
      {
        "field": "region",
        "title": "Region",
        "type": "nominal"
      },
      {
        "field": "rate",
        "title": "Recycling rate (%)",
        "format": ".1f",
        "type": "quantitative"
      },
      {
        "field": "year",
        "title": "Year",
        "type": "quantitative"
      }
    ]
  }
}
