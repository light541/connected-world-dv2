{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 380,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9eeed",
        "stroke": "#fff",
        "strokeWidth": 0.45
      }
    },
    {
      "data": {
        "values": []
      },
      "mark": {
        "type": "circle",
        "opacity": 0.52,
        "stroke": "#244653",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "subscriptionBand",
          "type": "ordinal",
          "sort": [
            "0–49",
            "50–99",
            "100–149",
            "150–199",
            "200+"
          ],
          "scale": {
            "domain": [
              "0–49",
              "50–99",
              "100–149",
              "150–199",
              "200+"
            ],
            "range": [
              18,
              45,
              85,
              135,
              205
            ]
          },
          "legend": {
            "title": "Subscriptions / 100 (bands)",
            "orient": "bottom"
          }
        },
        "color": {
          "value": "#23677a"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country",
            "type": "nominal"
          },
          {
            "field": "metric",
            "title": "Subscriptions / 100",
            "format": ".1f",
            "type": "quantitative"
          },
          {
            "field": "subscriptionBand",
            "type": "ordinal",
            "title": "Rate band"
          },
          {
            "field": "year",
            "title": "Year",
            "type": "quantitative"
          }
        ]
      }
    }
  ]
}
