{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 355,
  "data": {
    "values": []
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 2.5,
        "color": "#cdd9da"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "rate",
            "op": "max",
            "order": "descending"
          },
          "title": null
        },
        "x": {
          "field": "rate",
          "type": "quantitative",
          "title": "Formal e-waste recycling rate (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 83,
        "color": "#2b7880"
      },
      "encoding": {
        "x": {
          "field": "rate",
          "type": "quantitative",
          "title": "Formal e-waste recycling rate (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "rate",
            "op": "max",
            "order": "descending"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "rate",
            "title": "Recycling rate (%)",
            "format": ".1f",
            "type": "quantitative"
          }
        ]
      }
    }
  ]
}
