{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e6ebef",
      "gridOpacity": 0.8,
      "labelColor": "#50606e",
      "titleColor": "#334450",
      "tickColor": "#d6dee4",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "legend": {
      "labelColor": "#445563",
      "titleColor": "#334450",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "title": {
      "color": "#182d3a",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#24566b",
        "#77a9ac",
        "#b49a76",
        "#6390b0",
        "#78917c",
        "#c0a1a0",
        "#5f7485"
      ]
    }
  },
  "width": "container",
  "height": 326,
  "data": {
    "values": []
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 61,
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "subscriptions",
          "type": "quantitative",
          "title": "Mobile subscriptions per 100 people",
          "scale": {
            "domain": [
              0,
              250
            ]
          }
        },
        "y": {
          "field": "internet",
          "type": "quantitative",
          "title": "Individuals using the internet (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "color": {
          "value": "#638c9a"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal"
          },
          {
            "field": "internet",
            "title": "Internet access (%)",
            "format": ".1f",
            "type": "quantitative"
          },
          {
            "field": "subscriptions",
            "title": "Subs / 100",
            "format": ".1f",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.iso === 'MYS'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "color": "#cc7e52",
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "subscriptions",
          "type": "quantitative"
        },
        "y": {
          "field": "internet",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.iso === 'MYS'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -11,
        "fontWeight": "bold",
        "color": "#a25435"
      },
      "encoding": {
        "x": {
          "field": "subscriptions",
          "type": "quantitative"
        },
        "y": {
          "field": "internet",
          "type": "quantitative"
        },
        "text": {
          "value": "Malaysia"
        }
      }
    }
  ]
}
